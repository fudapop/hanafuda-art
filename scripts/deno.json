{
  "imports": {
    "@std/path": "jsr:@std/path@1.1.1",
    "@std/cli": "jsr:@std/cli",
    "@std/fs": "jsr:@std/fs",
    "@std/dotenv": "jsr:@std/dotenv",
    "@supabase/supabase-js": "jsr:@supabase/supabase-js@^2"
  },
  "nodeModulesDir": "auto",
  "tasks": {
    "upload-to-static": "deno run --allow-read --allow-write --allow-env --allow-net --allow-run ./upload-to-static.ts",
    "upload-to-gcs": "deno run --allow-read --allow-env --allow-net --allow-run ./upload-to-gcs.ts",
    "release": "node --experimental-strip-types ./release-calver.ts",
    "release:dry-run": "node --experimental-strip-types ./release-calver.ts --dry-run"
  }
}
