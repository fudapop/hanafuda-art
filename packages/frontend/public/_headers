# Cloudflare Pages cache rules.
#
# The service worker and the HTML shell must revalidate on every request.
# Otherwise a long Cache-Control lifetime serves the previous sw.js, the
# update check never sees a deploy, and installed clients stay on the old build.
# Hashed /_nuxt assets are safe to keep; their names change when the bytes do.
#
# Later matching rules override earlier ones for the same header. The hashed
# asset rule overrides the broad no-cache rule, and the shell rules come last
# so sw.js and index.html stay revalidated.

/*
  Cache-Control: no-cache

/_nuxt/*
  Cache-Control: public, max-age=31536000, immutable

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/200.html
  Cache-Control: no-cache

/404.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache
