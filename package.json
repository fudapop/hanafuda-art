{
  "name": "hanafuda-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -F @hanafuda/frontend dev",
    "build": "pnpm -F @hanafuda/frontend build",
    "generate": "pnpm -F @hanafuda/frontend generate",
    "test": "pnpm -F @hanafuda/frontend test",
    "test:release": "node --experimental-strip-types --test scripts/release-calver.test.ts",
    "dev:backend": "pnpm -F @hanafuda/backend dev",
    "build:backend": "pnpm -F @hanafuda/backend build",
    "release": "node --experimental-strip-types scripts/release-calver.ts",
    "release:dry-run": "node --experimental-strip-types scripts/release-calver.ts --dry-run"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "packageManager": "pnpm@10.5.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
